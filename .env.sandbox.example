# Copy to .env.sandbox (git-ignored) to run `composer test:sandbox` and `composer test:terminal`.
# Use the credentials of the Pay. TEST account / test sales location, never live ones.
PAYNL_SANDBOX_TOKEN_CODE=AT-####-####
PAYNL_SANDBOX_API_TOKEN=
PAYNL_SANDBOX_SERVICE_ID=SL-####-####

# Terminal scenarios only: the terminal on the test account and the amount sent to it, in cents.
PAYNL_SANDBOX_TERMINAL=TH-####-####
PAYNL_SANDBOX_TERMINAL_AMOUNT=1
# Sends integration.test with the terminal orders. Set false if Pay. refuses test mode on the terminal.
PAYNL_SANDBOX_TESTMODE=true
# Seconds to wait for a final status (scenario 3 waits for the terminal to time out).
PAYNL_SANDBOX_TIMEOUT=180
# Scenario 4: seconds to start a payment from the Pay. Admin Panel (Collect desk) before the POS sends one.
PAYNL_SANDBOX_BUSY_WAIT=20

# stats.object; empty sends XVE's PartnerID (PaynlService::PARTNER_ID), as every project does.
PAYNL_SANDBOX_STATS_OBJECT=
# Optional public url (Expose/ngrok) so Pay. can reach the exchange during the terminal scenarios.
PAYNL_SANDBOX_URL=
